# exp09 gt_records (7.2G generated pickles, regenerable via gisec.datasets.build_gt_records)
experiments/ugnn/exp09_centernet_seeds/gt_records/

# exp17 band records (canonical band overlay, regenerable via gisec.datasets.build_band_records)
