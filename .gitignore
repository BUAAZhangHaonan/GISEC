# exp23/exp24 generated records (regenerable via the builders)
experiments/ugnn/exp23_seam_rank/gt_records/
experiments/ugnn/exp24_proj_anchor/gt_records/

# forward caches (regenerable via sweep scripts)
_cache_fwd/
_cache_fwd128k/

# per-image fullval prediction exports (110M; the reproduction-gate point
# estimates are recorded in the eval jsons / LEDGER instead)
e20_fullval_results.json
e25_fullval_results.json

# training-run artifacts: checkpoints/smoke dirs stay local; the formal E25
# run keeps its deploy-eval trace, train log and step visualizations tracked
experiments/ugnn/exp23_seam_rank/runs_smoke/
experiments/ugnn/exp24_proj_anchor/runs_evalgate/
experiments/ugnn/exp24_proj_anchor/runs_smoke/
experiments/ugnn/exp24_proj_anchor/runs_smoke128k/
experiments/ugnn/exp24_proj_anchor/runs_smoke_centroid/
experiments/ugnn/exp24_proj_anchor/runs_128k_b16/*
!experiments/ugnn/exp24_proj_anchor/runs_128k_b16/deploy_eval.jsonl
!experiments/ugnn/exp24_proj_anchor/runs_128k_b16/train_log.json
!experiments/ugnn/exp24_proj_anchor/runs_128k_b16/visualizations/

# package-level inference caches (regenerable via gisec-build-rgb-cache /
# gisec-postproc-cache; roots overridable via GISEC_RGB_CACHE /
# GISEC_POSTPROC_CACHE)
/cache_rgb/
/cache_postproc/

# gpu_extreme arena regenerable payloads (832MB, from make_payloads.py)
experiments/ugnn/gpu_extreme/arena/payloads/
# gpu_extreme host-specific build artifacts (engines, load_inline builds)
experiments/ugnn/gpu_extreme/team_ws/build/
experiments/ugnn/gpu_extreme/team_trt/*.engine
experiments/ugnn/gpu_extreme/team_trt/cache.trt
